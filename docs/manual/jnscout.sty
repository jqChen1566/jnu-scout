%% jnscout.sty -- shared macros and layout for the JNUScout manual.
%% Build with XeLaTeX (fontspec); see build.sh for the full pass sequence.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jnscout}[2026/10/01 JNUScout manual style]

% --- fonts (XeLaTeX) ---------------------------------------------------------
\RequirePackage{fontspec}
\setmainfont{TeX Gyre Termes}
\setsansfont{TeX Gyre Heros}
\setmonofont{DejaVuSansMono}[
  Extension=.ttf,
  UprightFont=*,
  BoldFont=*-Bold,
  ItalicFont=*-Oblique,
  BoldItalicFont=*-BoldOblique,
  Scale=0.84,
]

% --- page, language, structure ----------------------------------------------
\RequirePackage[british]{babel}
\RequirePackage{microtype}
\RequirePackage[htt]{hyphenat}   % hyphenate \texttt runs (long paths, identifiers)
\setlength{\emergencystretch}{2em}  % last-resort stretch: avoids overfull prose boxes
\RequirePackage{scrlayer-scrpage}
\clearpairofpagestyles
\automark[section]{chapter}
\ihead{\headmark}
\ohead{\pagemark}
\setkomafont{pagehead}{\normalfont\sffamily\small}

% --- maths, tables, boxes, code ---------------------------------------------
\RequirePackage{amsmath, amssymb}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=3pt}
\RequirePackage{xcolor}
\definecolor{jnsblue}{HTML}{1F4E79}
\definecolor{jnsgray}{HTML}{F2F2F2}
\definecolor{jnsframe}{HTML}{C8C8C8}
\definecolor{jnswarn}{HTML}{8B2500}
\RequirePackage[most]{tcolorbox}
\RequirePackage{caption}
\RequirePackage{listings}
\RequirePackage{makeidx}
\RequirePackage{url}

\lstdefinestyle{jnscode}{%
  basicstyle=\ttfamily\small,
  breaklines=true,
  breakatwhitespace=false,
  postbreak=\mbox{\textcolor{jnsblue}{$\hookrightarrow$}\space},
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  framerule=0.4pt,
  rulecolor=\color{jnsframe},
  backgroundcolor=\color{jnsgray},
  xleftmargin=1em, xrightmargin=0.5em,
  aboveskip=0.8em, belowskip=0.8em,
}
\lstnewenvironment{transcript}[1][]{\lstset{style=jnscode,#1}}{}
\lstnewenvironment{excerpt}[1][]{\lstset{style=jnscode,#1}}{}
\lstnewenvironment{codeblock}[1][]{\lstset{style=jnscode,#1}}{}

% float-free boxes
\newtcolorbox{notebox}[1][Note]{%
  colback=jnsgray, colframe=jnsframe, boxrule=0.4pt,
  fonttitle=\bfseries\sffamily, title=#1, arc=1mm, left=2mm, right=2mm,
}
\newtcolorbox{refusalbox}[1][What it will not do]{%
  colback=white, colframe=jnswarn, boxrule=0.6pt,
  fonttitle=\bfseries\sffamily\color{jnswarn}, title=#1, arc=1mm,
  left=2mm, right=2mm,
}
\newtcolorbox{readbox}[1][How to read the numbers]{%
  colback=white, colframe=jnsblue, boxrule=0.6pt,
  fonttitle=\bfseries\sffamily\color{jnsblue}, title=#1, arc=1mm,
  left=2mm, right=2mm,
}

% --- hyperref last ----------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=jnsblue, citecolor=jnsblue,
                urlcolor=jnsblue, pdftitle={JNUScout manual},
                pdfauthor={The JNUScout developers}]{hyperref}

% --- bibliography (biber; loaded after hyperref) -----------------------------
\RequirePackage[backend=biber, style=numeric-comp, giveninits=true,
                maxbibnames=99, maxcitenames=2]{biblatex}

% --- shorthand macros --------------------------------------------------------
\newcommand{\jns}{\textsf{JNUScout}}
% \script{name} formats a script name with a literal underscore; keep the
% argument bare (no backslash-escaped underscores).
% The detokenizing macros are declared robust so they can be used in moving
% arguments (section titles, captions): a non-robust macro would expand at
% write time and leak catcode-12 underscores into the .toc.
\DeclareRobustCommand{\script}[1]{\texttt{\detokenize{#1}.py}}
\DeclareRobustCommand{\scriptlabel}[1]{}% kept for call-site compatibility
\DeclareRobustCommand{\file}[1]{\texttt{\detokenize{#1}}}
\DeclareRobustCommand{\code}[1]{\texttt{\detokenize{#1}}}
\newcommand{\bibkey}[1]{\texttt{#1}}
